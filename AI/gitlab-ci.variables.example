# GitLab CI/CD Variables example
# Register these in GitLab:
# Settings > CI/CD > Variables

DEPLOY_HOST=your.server.example.com
DEPLOY_PORT=22
DEPLOY_USER=ubuntu
DEPLOY_SSH_PRIVATE_KEY=-----BEGIN_OPENSSH_PRIVATE_KEY-----your-private-key-----END_OPENSSH_PRIVATE_KEY-----
DEPLOY_ENV_FILE=/home/ubuntu/inference/.env
DEPLOY_CONTAINER_NAME=merchant-inference-service
DEPLOY_PORT_MAP=8000:8000
