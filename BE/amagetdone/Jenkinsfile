pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_DIR = 'BE/amagetdone'
        PROD_JENKINS_APP_ENV = '/var/jenkins_home/secrets/amagetdone.app.env'
        PROD_JENKINS_DEPLOY_ENV = '/var/jenkins_home/secrets/amagetdone.env'
        DEV_JENKINS_APP_ENV = '/var/jenkins_home/secrets/amagetdone-dev.app.env'
        DEV_JENKINS_DEPLOY_ENV = '/var/jenkins_home/secrets/amagetdone-dev.env'
        DEV_DEPLOY_SCRIPT = '/home/ubuntu/deploy/amagetdone-dev/deploy.sh'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -eux

                        case "$BRANCH_NAME" in
                          "dev/backend")
                            app_env="$DEV_JENKINS_APP_ENV"
                            ;;
                          *)
                            app_env="$PROD_JENKINS_APP_ENV"
                            ;;
                        esac

                        if [ ! -f "$app_env" ]; then
                          echo "Jenkins app env file not found: $app_env" >&2
                          exit 1
                        fi

                        install -m 600 "$app_env" ./.env
                        chmod +x ./gradlew
                        ./gradlew clean test bootJar
                    '''
                }
            }
        }

        stage('Deploy Main') {
            when {
                branch 'main'
            }
            steps {
                sshagent(credentials: ['oci-prod-ssh']) {
                    sh '''
                        set -eu

                        if [ ! -f "$PROD_JENKINS_DEPLOY_ENV" ]; then
                          echo "Jenkins deploy env file not found: $PROD_JENKINS_DEPLOY_ENV" >&2
                          exit 1
                        fi

                        set -a
                        . "$PROD_JENKINS_DEPLOY_ENV"
                        set +a

                        require_value() {
                          value="$1"
                          name="$2"
                          if [ -z "$value" ]; then
                            echo "Required Jenkins deploy env is missing: $name" >&2
                            exit 1
                          fi
                        }

                        require_value "$REMOTE_HOST" REMOTE_HOST
                        require_value "$REMOTE_PORT" REMOTE_PORT
                        require_value "$REMOTE_USER" REMOTE_USER
                        require_value "$REMOTE_APP_DIR" REMOTE_APP_DIR
                        require_value "$REMOTE_DEPLOY_SCRIPT" REMOTE_DEPLOY_SCRIPT
                        require_value "$REMOTE_HEALTH_URL" REMOTE_HEALTH_URL
                        require_value "$EXTERNAL_HEALTH_URL" EXTERNAL_HEALTH_URL

                        mkdir -p ~/.ssh
                        chmod 700 ~/.ssh
                        ssh-keyscan -p "$REMOTE_PORT" -H "$REMOTE_HOST" >> ~/.ssh/known_hosts

                        cd "$WORKSPACE/$APP_DIR"
                        rsync -az --delete \
                          --exclude '.git' \
                          --exclude '.gradle' \
                          --exclude 'build' \
                          -e "ssh -p $REMOTE_PORT" \
                          ./ "$REMOTE_USER@$REMOTE_HOST:$REMOTE_APP_DIR/"

                        deploy_rc=0
                        ssh -p "$REMOTE_PORT" "$REMOTE_USER@$REMOTE_HOST" "
                          set -eu
                          sudo -n bash '$REMOTE_DEPLOY_SCRIPT'
                        " || deploy_rc=$?
                        if [ "$deploy_rc" -ne 0 ]; then
                          echo "deploy.sh exited with code $deploy_rc; deferring final judgment to health checks"
                        fi

                        for attempt in $(seq 1 40); do
                          if ssh -p "$REMOTE_PORT" "$REMOTE_USER@$REMOTE_HOST" "curl -fsS '$REMOTE_HEALTH_URL'" >/dev/null; then
                            break
                          fi
                          if [ "$attempt" -eq 40 ]; then
                            echo "Remote health check failed: $REMOTE_HEALTH_URL" >&2
                            exit 1
                          fi
                          sleep 3
                        done

                        for attempt in $(seq 1 40); do
                          if curl -kfsS "$EXTERNAL_HEALTH_URL" >/dev/null; then
                            exit 0
                          fi
                          if [ "$attempt" -eq 40 ]; then
                            echo "External health check failed: $EXTERNAL_HEALTH_URL" >&2
                            exit 1
                          fi
                          sleep 3
                        done
                    '''
                }
            }
        }

        stage('Deploy Dev Backend') {
            when {
                branch 'dev/backend'
            }
            steps {
                sh '''
                    set -eu

                    if [ ! -f "$DEV_JENKINS_DEPLOY_ENV" ]; then
                      echo "Jenkins deploy env file not found: $DEV_JENKINS_DEPLOY_ENV" >&2
                      exit 1
                    fi

                    if [ ! -f "$DEV_JENKINS_APP_ENV" ]; then
                      echo "Jenkins app env file not found: $DEV_JENKINS_APP_ENV" >&2
                      exit 1
                    fi

                    set -a
                    . "$DEV_JENKINS_DEPLOY_ENV"
                    set +a

                    require_value() {
                      value="$1"
                      name="$2"
                      if [ -z "$value" ]; then
                        echo "Required Jenkins dev deploy env is missing: $name" >&2
                        exit 1
                      fi
                    }

                    require_value "$LOCAL_REPO_DIR" LOCAL_REPO_DIR
                    require_value "$LOCAL_APP_DIR" LOCAL_APP_DIR
                    require_value "$LOCAL_HEALTH_URL" LOCAL_HEALTH_URL
                    require_value "$EXTERNAL_HEALTH_URL" EXTERNAL_HEALTH_URL
                    require_value "$DEV_DEPLOY_SCRIPT" DEV_DEPLOY_SCRIPT

                    if [ ! -d "$LOCAL_REPO_DIR/.git" ]; then
                      echo "Local repo dir is not a git repository: $LOCAL_REPO_DIR" >&2
                      exit 1
                    fi

                    if [ ! -d "$LOCAL_APP_DIR" ]; then
                      echo "Local app dir not found: $LOCAL_APP_DIR" >&2
                      exit 1
                    fi

                    git -C "$LOCAL_REPO_DIR" fetch --all --prune
                    git -C "$LOCAL_REPO_DIR" checkout dev/backend
                    git -C "$LOCAL_REPO_DIR" reset --hard origin/dev/backend

                    install -m 600 "$DEV_JENKINS_APP_ENV" "$LOCAL_APP_DIR/.env"

                    bash "$DEV_DEPLOY_SCRIPT"

                    for attempt in $(seq 1 40); do
                      if curl -fsS "$LOCAL_HEALTH_URL" >/dev/null; then
                        break
                      fi
                      if [ "$attempt" -eq 40 ]; then
                        echo "Local health check failed: $LOCAL_HEALTH_URL" >&2
                        exit 1
                      fi
                      sleep 3
                    done

                    for attempt in $(seq 1 40); do
                      if curl -fsS "$EXTERNAL_HEALTH_URL" >/dev/null; then
                        exit 0
                      fi
                      if [ "$attempt" -eq 40 ]; then
                        echo "External health check failed: $EXTERNAL_HEALTH_URL" >&2
                        exit 1
                      fi
                      sleep 3
                    done
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
