pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_DIR = 'BE/amagetdone'
        JENKINS_APP_ENV = '/var/jenkins_home/secrets/amagetdone.app.env'
        JENKINS_DEPLOY_ENV = '/var/jenkins_home/secrets/amagetdone.env'
        JENKINS_DEV_APP_ENV = '/var/jenkins_home/secrets/amagetdone-dev.app.env'
        JENKINS_DEV_DEPLOY_ENV = '/var/jenkins_home/secrets/amagetdone-dev.env'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -eux
                        APP_ENV_FILE="$JENKINS_APP_ENV"
                        if [ "$BRANCH_NAME" = "dev/backend" ]; then
                          APP_ENV_FILE="$JENKINS_DEV_APP_ENV"
                        fi

                        if [ ! -f "$APP_ENV_FILE" ]; then
                          echo "Jenkins app env file not found: $APP_ENV_FILE" >&2
                          exit 1
                        fi
                        install -m 600 "$APP_ENV_FILE" ./.env
                        chmod +x ./gradlew
                        ./gradlew clean test bootJar
                    '''
                }
            }
        }

        stage('Deploy Production') {
            when {
                branch 'main'
            }
            steps {
                sshagent(credentials: ['oci-prod-ssh']) {
                    sh '''
                        set -eu

                        if [ ! -f "$JENKINS_DEPLOY_ENV" ]; then
                          echo "Jenkins deploy env file not found: $JENKINS_DEPLOY_ENV" >&2
                          exit 1
                        fi

                        set -a
                        . "$JENKINS_DEPLOY_ENV"
                        set +a

                        require_value() {
                          value="$1"
                          name="$2"
                          if [ -z "$value" ]; then
                            echo "Required Jenkins deploy env is missing: $name" >&2
                            exit 1
                          fi
                        }

                        require_value "$REMOTE_HOST" REMOTE_HOST
                        require_value "$REMOTE_PORT" REMOTE_PORT
                        require_value "$REMOTE_USER" REMOTE_USER
                        require_value "$REMOTE_APP_DIR" REMOTE_APP_DIR
                        require_value "$REMOTE_DEPLOY_SCRIPT" REMOTE_DEPLOY_SCRIPT
                        require_value "$REMOTE_HEALTH_URL" REMOTE_HEALTH_URL
                        require_value "$EXTERNAL_HEALTH_URL" EXTERNAL_HEALTH_URL

                        mkdir -p ~/.ssh
                        chmod 700 ~/.ssh
                        ssh-keyscan -p "$REMOTE_PORT" -H "$REMOTE_HOST" >> ~/.ssh/known_hosts

                        cd "$WORKSPACE/$APP_DIR"
                        rsync -az --delete \
                          --exclude '.git' \
                          --exclude '.gradle' \
                          --exclude 'build' \
                          -e "ssh -p $REMOTE_PORT" \
                          ./ "$REMOTE_USER@$REMOTE_HOST:$REMOTE_APP_DIR/"

                        deploy_rc=0
                        ssh -p "$REMOTE_PORT" "$REMOTE_USER@$REMOTE_HOST" "
                          set -eu
                          sudo -n bash '$REMOTE_DEPLOY_SCRIPT'
                        " || deploy_rc=$?
                        if [ "$deploy_rc" -ne 0 ]; then
                          echo "deploy.sh exited with code $deploy_rc; deferring final judgment to health checks"
                        fi

                        for attempt in $(seq 1 40); do
                          if ssh -p "$REMOTE_PORT" "$REMOTE_USER@$REMOTE_HOST" "curl -fsS '$REMOTE_HEALTH_URL'" >/dev/null; then
                            break
                          fi
                          if [ "$attempt" -eq 40 ]; then
                            echo "Remote health check failed: $REMOTE_HEALTH_URL" >&2
                            exit 1
                          fi
                          sleep 3
                        done

                        for attempt in $(seq 1 40); do
                          if curl -kfsS "$EXTERNAL_HEALTH_URL" >/dev/null; then
                            exit 0
                          fi
                          if [ "$attempt" -eq 40 ]; then
                            echo "External health check failed: $EXTERNAL_HEALTH_URL" >&2
                            exit 1
                          fi
                          sleep 3
                        done
                    '''
                }
            }
        }

        stage('Deploy Dev Backend') {
            when {
                branch 'dev/backend'
            }
            steps {
                sh '''
                    set -eu

                    if [ ! -f "$JENKINS_DEV_DEPLOY_ENV" ]; then
                      echo "Jenkins dev deploy env file not found: $JENKINS_DEV_DEPLOY_ENV" >&2
                      exit 1
                    fi

                    if [ ! -f "$JENKINS_DEV_APP_ENV" ]; then
                      echo "Jenkins dev app env file not found: $JENKINS_DEV_APP_ENV" >&2
                      exit 1
                    fi

                    set -a
                    . "$JENKINS_DEV_DEPLOY_ENV"
                    set +a

                    require_value() {
                      value="$1"
                      name="$2"
                      if [ -z "$value" ]; then
                        echo "Required Jenkins dev deploy env is missing: $name" >&2
                        exit 1
                      fi
                    }

                    require_value "${LOCAL_REPO_DIR:-}" LOCAL_REPO_DIR
                    require_value "${LOCAL_APP_DIR:-}" LOCAL_APP_DIR
                    require_value "${LOCAL_HEALTH_URL:-}" LOCAL_HEALTH_URL
                    require_value "${EXTERNAL_HEALTH_URL:-}" EXTERNAL_HEALTH_URL

                    docker run --rm \
                      -v "$LOCAL_REPO_DIR:/repo" \
                      -w /repo \
                      alpine/git:2.47.2 \
                      sh -lc "
                        set -eu
                        git fetch origin
                        git checkout dev/backend
                        git reset --hard '$GIT_COMMIT'
                      "

                    docker run --rm -i \
                      -v "$LOCAL_APP_DIR:/dest" \
                      alpine:3.20 \
                      sh -lc 'cat > /dest/.env && chmod 600 /dest/.env' \
                      < "$JENKINS_DEV_APP_ENV"

                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v "$LOCAL_APP_DIR:/app" \
                      -w /app \
                      docker:27-cli \
                      sh -lc '
                        set -eu
                        docker compose version
                        sh ./scripts/deploy-dev.sh
                      '

                    for attempt in $(seq 1 40); do
                      if docker run --rm --network host curlimages/curl:8.12.1 \
                        -fsS "$LOCAL_HEALTH_URL" >/dev/null; then
                        break
                      fi
                      if [ "$attempt" -eq 40 ]; then
                        echo "Local dev health check failed: $LOCAL_HEALTH_URL" >&2
                        exit 1
                      fi
                      sleep 3
                    done

                    for attempt in $(seq 1 40); do
                      if curl -fsS "$EXTERNAL_HEALTH_URL" >/dev/null; then
                        exit 0
                      fi
                      if [ "$attempt" -eq 40 ]; then
                        echo "External dev health check failed: $EXTERNAL_HEALTH_URL" >&2
                        exit 1
                      fi
                      sleep 3
                    done
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
