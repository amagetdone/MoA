# Create the real file on the Jenkins host at:
# /home/ubuntu/jenkins_home/secrets/amagetdone.env
#
# Jenkins reads it inside the container at:
# /var/jenkins_home/secrets/amagetdone.env

REMOTE_HOST=your-public-host-or-dns
REMOTE_PORT=22
REMOTE_USER=your-ssh-user
REMOTE_APP_DIR=/path/to/remote/app
REMOTE_DEPLOY_SCRIPT=/path/to/deploy.sh
REMOTE_HEALTH_URL=http://127.0.0.1:8080/health
EXTERNAL_HEALTH_URL=https://your-domain/api/health
