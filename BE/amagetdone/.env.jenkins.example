# Production deploy env on Jenkins host:
# /home/ubuntu/jenkins_home/secrets/amagetdone.env
# /home/ubuntu/jenkins_home/secrets/amagetdone.app.env
#
# Dev deploy env on Jenkins host:
# /home/ubuntu/jenkins_home/secrets/amagetdone-dev.env
# /home/ubuntu/jenkins_home/secrets/amagetdone-dev.app.env

# Production deploy env example
REMOTE_HOST=your-public-host-or-dns
REMOTE_PORT=22
REMOTE_USER=your-ssh-user
REMOTE_APP_DIR=/path/to/remote/app
REMOTE_DEPLOY_SCRIPT=/path/to/deploy.sh
REMOTE_HEALTH_URL=http://127.0.0.1:8080/api/health
EXTERNAL_HEALTH_URL=https://your-domain/api/health

# Production app env example
COMPOSE_PROJECT_NAME=amagetdone
COMPOSE_HOST_BIND=127.0.0.1
SPRING_PROFILES_ACTIVE=prod
COMPOSE_HOST_PORT=8080
SERVER_PORT=8080
BACKEND_CONTAINER_NAME=amagetdone-backend
POSTGRES_CONTAINER_NAME=amagetdone-postgres
PGADMIN_CONTAINER_NAME=amagetdone-pgadmin
REDIS_CONTAINER_NAME=amagetdone-redis
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=amagetdone
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
DB_URL=jdbc:postgresql://postgres:5432/amagetdone
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
JWT_SECRET=your-jwt-secret
OPENAI_API_KEY=your-api-key
SSAFY_FIN_API_KEY=your-ssafy-fin-api-key
MCP_FINANCE_ENABLED=false
KAKAO_NATIVE_APP_KEY=dc7399448130
GOOGLE_CLIENT_ID=26025204114-
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
PGADMIN_HOST_BIND=127.0.0.1
PGADMIN_HOST_PORT=8108
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_PASSWORD=your-redis-password

# Dev deploy env example
LOCAL_REPO_DIR=/home/ubuntu/project/S14P21D101-dev
LOCAL_APP_DIR=/home/ubuntu/project/S14P21D101-dev/BE/amagetdone
LOCAL_HEALTH_URL=http://127.0.0.1:8082/api/health
EXTERNAL_HEALTH_URL=http://127.0.0.1:8082/api/health
DEV_DEPLOY_SCRIPT=/home/ubuntu/deploy/amagetdone-dev/deploy.sh

# Dev app env example
COMPOSE_PROJECT_NAME=amagetdone-dev
COMPOSE_HOST_BIND=127.0.0.1
SPRING_PROFILES_ACTIVE=dev
COMPOSE_HOST_PORT=8082
SERVER_PORT=8080
BACKEND_CONTAINER_NAME=amagetdone-dev-backend
POSTGRES_CONTAINER_NAME=amagetdone-dev-postgres
PGADMIN_CONTAINER_NAME=amagetdone-dev-pgadmin
REDIS_CONTAINER_NAME=amagetdone-dev-redis
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433
PGADMIN_HOST_BIND=127.0.0.1
PGADMIN_HOST_PORT=8109
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380
POSTGRES_DB=amagetdone
POSTGRES_USER=your-dev-postgres-user
POSTGRES_PASSWORD=your-dev-postgres-password
DB_URL=jdbc:postgresql://postgres:5432/amagetdone
DB_USERNAME=your-dev-postgres-user
DB_PASSWORD=your-dev-postgres-password
JWT_SECRET=your-dev-jwt-secret
OPENAI_API_KEY=your-api-key
SSAFY_FIN_API_KEY=your-ssafy-fin-api-key
MCP_FINANCE_ENABLED=false
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-dev-redis-password
