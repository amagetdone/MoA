# Create the real file on the Jenkins host at:
# /home/ubuntu/jenkins_home/secrets/amagetdone.env
#
# Jenkins reads it inside the container at:
# /var/jenkins_home/secrets/amagetdone.env
# and the app test env file at:
# /var/jenkins_home/secrets/amagetdone.app.env

REMOTE_HOST=your-public-host-or-dns
REMOTE_PORT=22
REMOTE_USER=your-ssh-user
REMOTE_APP_DIR=/path/to/remote/app
REMOTE_DEPLOY_SCRIPT=/path/to/deploy.sh
REMOTE_HEALTH_URL=http://127.0.0.1:8080/health
EXTERNAL_HEALTH_URL=https://your-domain/api/health

# Create the second real file on the Jenkins host at:
# /home/ubuntu/jenkins_home/secrets/amagetdone.app.env
#
# Suggested content example:
# SPRING_PROFILES_ACTIVE=dev
# COMPOSE_HOST_PORT=8080
# SERVER_PORT=8080
# POSTGRES_DB=amagetdone
# POSTGRES_USER=your-postgres-user
# POSTGRES_PASSWORD=your-postgres-password
# DB_URL=jdbc:postgresql://amagetdone-test-postgres:5432/amagetdone
# DB_USERNAME=your-postgres-user
# DB_PASSWORD=your-postgres-password
# JWT_SECRET=your-jwt-secret
# OPENAI_API_KEY=your-api-key
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
# REDIS_HOST=amagetdone-redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
