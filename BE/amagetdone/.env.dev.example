SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROJECT_NAME=amagetdone-dev
COMPOSE_HOST_BIND=127.0.0.1
COMPOSE_HOST_PORT=8082
SERVER_PORT=8080

BACKEND_CONTAINER_NAME=amagetdone-dev-backend
POSTGRES_CONTAINER_NAME=amagetdone-dev-postgres
PGADMIN_CONTAINER_NAME=amagetdone-dev-pgadmin
REDIS_CONTAINER_NAME=amagetdone-dev-redis
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380

POSTGRES_DB=amagetdone
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password

DB_URL=jdbc:postgresql://postgres:5432/amagetdone
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password

JWT_SECRET=your-jwt-secret
OPENAI_API_KEY=your-api-key

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
PGADMIN_HOST_BIND=127.0.0.1
PGADMIN_HOST_PORT=8109

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
